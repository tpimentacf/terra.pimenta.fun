      "provider": "provider[\"registry.terraform.io/cloudflare/cloudflare\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "account_id": null,
            "description": "Terraform zone-level custom rules",
            "id": "7263cf753ecb4352be1d7e063a276b57",
            "kind": "zone",
            "name": "Terraform zone-level custom rules",
            "phase": "http_request_firewall_custom",
            "rules": [
              {
                "action": "block",
                "action_parameters": [],
                "description": "Block requests from country PT",
                "enabled": true,
                "exposed_credential_check": [],
                "expression": "(http.host wildcard \"dev.pimenta.fun\" and ip.geoip.country ne \"PT\")",
                "id": "c29ce75e5e874595a7edd2dc28a0dbeb",
                "logging": [],
                "ratelimit": [],
                "ref": "c29ce75e5e874595a7edd2dc28a0dbeb"
              },
              {
                "action": "block",
                "action_parameters": [],
                "description": "Block SQL Injection attempts",
                "enabled": true,
                "exposed_credential_check": [],
                "expression": "(http.request.uri.query contains \"SELECT\" and http.request.uri.query contains \"FROM\")",
                "id": "6330d0adcaed4bc6863b5a3e997cf8ef",
                "logging": [],
                "ratelimit": [],
                "ref": "6330d0adcaed4bc6863b5a3e997cf8ef"
              },
              {
                "action": "block",
                "action_parameters": [],
                "description": "Block Access to path /resources/* if method not GET",
                "enabled": true,
                "exposed_credential_check": [],
                "expression": "(http.request.uri.path eq \"/guesttokens\" and not http.request.method in {\"GET\"})",
                "id": "f22a956d5ea24a7f91da7fafd7b24617",
                "logging": [],
                "ratelimit": [],
                "ref": "f22a956d5ea24a7f91da7fafd7b24617"
              }
            ],
            "zone_id": "94549a712608afcf7e89b2066cd122b9"
          },
          "sensitive_attributes": [],
          "dependencies": [
            "cloudflare_zone.zone"
          ]
        }
      ]
    },
